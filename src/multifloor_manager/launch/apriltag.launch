<?xml version="1.0"?>
<launch>
  <arg name="image_rect"/>
  <arg name="camera_info"/>
  <arg name="tag_config"/>
  <arg name="tag_topic" default="/tag_detections"/>

  <!-- Synchronise image/camera_info stamps because the D435 currently
       publishes them from different clocks.  Without this, apriltag_ros
       receives no synchronised pair and crashes with zarray_size assertion. -->
  <node pkg="multifloor_manager" type="camera_info_stamp_relay.py"
        name="camera_info_stamp_relay" output="screen">
    <param name="input_transport" value="compressed"/>
    <remap from="~compressed_image" to="$(arg image_rect)/compressed"/>
    <remap from="~image" to="$(arg image_rect)"/>
    <remap from="~camera_info" to="$(arg camera_info)"/>
    <remap from="~compressed_out" to="/apriltag_camera/image_raw/compressed"/>
    <remap from="~image_out" to="/apriltag_camera/image_raw"/>
    <remap from="~camera_info_out" to="/apriltag_camera/camera_info"/>
  </node>

  <node pkg="apriltag_ros" type="apriltag_ros_continuous_node"
        name="apriltag_ros_continuous_node" clear_params="true" output="screen"
        respawn="true" respawn_delay="3">
    <rosparam command="load" file="$(find apriltag_ros)/config/settings.yaml"/>
    <rosparam command="load" file="$(arg tag_config)"/>
    <param name="tag_family" value="tagStandard41h12"/>
    <param name="transport_hint" value="raw"/>
    <remap from="image_rect" to="/apriltag_camera/image_raw"/>
    <remap from="camera_info" to="/apriltag_camera/camera_info"/>
    <remap from="tag_detections" to="$(arg tag_topic)"/>
  </node>
</launch>
