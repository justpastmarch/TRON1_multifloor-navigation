<?xml version="1.0"?>
<launch>
  <arg name="cloud_in"/>
  <arg name="transform_tolerance" default="0.05"/>
  <arg name="min_height" default="-0.20"/>
  <arg name="max_height" default="0.20"/>
  <arg name="angle_min" default="-3.14159"/>
  <arg name="angle_max" default="3.14159"/>
  <arg name="angle_increment" default="0.00872665"/>
  <arg name="scan_time" default="0.10"/>
  <arg name="range_min" default="0.30"/>
  <arg name="range_max" default="1.35"/>

  <node pkg="pointcloud_to_laserscan" type="pointcloud_to_laserscan_node"
        name="pointcloud_to_laserscan" output="screen">
    <remap from="cloud_in" to="$(arg cloud_in)"/>
    <remap from="scan" to="/scan"/>
    <param name="target_frame" value="base_Link"/>
    <param name="transform_tolerance" value="$(arg transform_tolerance)"/>
    <param name="min_height" value="$(arg min_height)"/>
    <param name="max_height" value="$(arg max_height)"/>
    <param name="angle_min" value="$(arg angle_min)"/>
    <param name="angle_max" value="$(arg angle_max)"/>
    <param name="angle_increment" value="$(arg angle_increment)"/>
    <param name="scan_time" value="$(arg scan_time)"/>
    <param name="range_min" value="$(arg range_min)"/>
    <param name="range_max" value="$(arg range_max)"/>
    <param name="use_inf" value="true"/>
    <param name="inf_epsilon" value="1.0"/>
    <param name="concurrency_level" value="1"/>
  </node>
</launch>
