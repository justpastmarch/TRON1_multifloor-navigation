Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /3D PointCloud1
        - /Wheel Odometry1
        - /TF1
      Splitter Ratio: 0.5
    Tree Height: 600
  - Class: rviz/Views
    Name: Views
    Expanded:
      - /Current View1
    Splitter Ratio: 0.5
Preferences:
  PromptSaveOnExit: false
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Ground Grid
      Enabled: true
      Alpha: 0.25
      Cell Size: 1
      Color: 120; 120; 125
      Line Style:
        Line Width: 0.03
        Value: Lines
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 50
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/PointCloud2
      Name: 3D PointCloud
      Enabled: true
      Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Channel Name: intensity
      Color Transformer: Intensity
      Decay Time: 0.5
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Flat Squares
      Topic: /livox/lidar
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/LaserScan
      Name: 2D LiDAR Scan
      Enabled: true
      Alpha: 1
      Color: 255; 128; 0
      Color Transformer: FlatColor
      Decay Time: 0
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.04
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz/Odometry
      Name: Wheel Odometry
      Enabled: true
      Angle Tolerance: 0.1
      Keep: 5000
      Position Tolerance: 0.03
      Shape: Arrow
      Topic: /tron/wheel_odom_raw
      Unreliable: false
      Value: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Marker Alpha: 0.8
      Marker Scale: 0.5
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
    - Class: rviz/Image
      Name: RGB Camera
      Enabled: true
      Normalize Range: true
      Queue Size: 2
      Transport Hint: compressed
      Topic: /camera1/color/image_raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 38
    Default Light: true
    Fixed Frame: odom
    Frame Rate: 30
  Name: bag replay
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Target Frame: <Fixed Frame>
      Yaw: 0.8
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  X: 40
  Y: 40
