<launch>
  <param name="/mission_test/scenario" value="default" />

  <node pkg="mission_manager" type="mock_mission_children.py"
        name="mock_mission_children" required="true" />

  <node pkg="mission_manager" type="mission_manager_node.py"
        name="mission_manager" required="true">
    <env name="PATH" value="$(find mission_manager)/test/bin:$(env PATH)" />
    <param name="config_profile" value="test_fixture" />
    <param name="allow_test_fixture" value="true" />
    <param name="fixture_config_root" value="$(find mission_manager)/../../test/fixtures/building_valid" />
    <param name="home_location_id" value="home_3f" />
    <param name="initial_location_id" value="home_3f" />
    <param name="inspect_profile_id" value="roof_scan_profile" />
    <param name="scan_output_base" value="/tmp/tron1-$(anon manual-mission)" />
  </node>

  <test test-name="manual_mission_client" pkg="mission_manager"
        type="manual_mission_client.py" time-limit="45">
    <param name="artifact_output" value="/tmp/opencode/task14-manual-mission.json" />
  </test>
</launch>
