#!/usr/bin/env python3
"""Test-only rosbag executable controlled by /mission_test/scenario."""

from __future__ import annotations

from pathlib import Path
import signal
import subprocess
import sys
import time


TOPICS = (
    "/scan/points",
    "/camera/color/image_raw",
    "/camera/depth/image_raw",
    "/imu/data",
    "/tf",
    "/localization/pose",
)


def scenario() -> str:
    try:
        completed = subprocess.run(
            ("rosparam", "get", "/mission_test/scenario"),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5.0,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return "default"
    return completed.stdout.strip() if completed.returncode == 0 else "default"


def record(arguments: list[str]) -> int:
    artifact = Path(arguments[arguments.index("-O") + 1])
    stopped = False

    def stop(_signum, _frame) -> None:
        nonlocal stopped
        stopped = True

    signal.signal(signal.SIGINT, stop)
    if scenario() == "scan_failure":
        return 3
    artifact.parent.mkdir(parents=True, exist_ok=True)
    active_artifact = Path(str(artifact) + ".active")
    active_artifact.write_bytes(b"fixture bag")
    while not stopped:
        time.sleep(0.01)
    active_artifact.replace(artifact)
    return 0


def info() -> int:
    dirty = scenario() == "dirty_artifact"
    topics = TOPICS[:-1] if dirty else TOPICS
    print("duration: 0.2")
    print("topics:")
    for topic in topics:
        print("  - topic: {}".format(topic))
        print("    messages: 1")
    return 0


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "record":
        return record(sys.argv[2:])
    if len(sys.argv) >= 2 and sys.argv[1] == "info":
        return info()
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
