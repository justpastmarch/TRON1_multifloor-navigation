<launch>
  <param name="/move_base/TrajectoryPlannerROS/xy_goal_tolerance" value="0.25" />
  <param name="/move_base/TrajectoryPlannerROS/yaw_goal_tolerance" value="0.2" />
  <node pkg="map_server" type="map_server" name="map_server" required="true"
        args="$(find multifloor_manager)/config/maps/floor_3F.yaml" />

  <node pkg="stair_supervisor" type="synthetic_stair_supervisor_node.py"
        name="stair_supervisor" required="true" output="screen">
    <param name="config_dir" value="$(find mission_manager)/../../test/fixtures/stair_synthetic" />
  </node>

  <node pkg="multifloor_manager" type="multifloor_manager_node.py"
        name="multifloor_manager" required="true" output="screen">
    <param name="config_root" value="$(find multifloor_manager)/config" />
    <param name="initial_floor" value="3F" />
    <param name="service_timeout" value="3.0" />
    <param name="tag_timeout" value="3.0" />
    <param name="transaction_timeout" value="5.0" />
  </node>

  <node pkg="mission_manager" type="mission_manager_node.py"
        name="mission_manager" required="true" output="screen">
    <param name="config_profile" value="production" />
    <param name="stair_config_root" value="$(find mission_manager)/../../test/fixtures/stair_synthetic" />
    <param name="home_location_id" value="home_3f" />
    <param name="initial_location_id" value="home_3f" />
    <param name="inspect_profile_id" value="roof_scan_profile" />
    <param name="scan_output_base" value="/dev/shm/tron1-full-system-synthetic" />
    <param name="state_freshness_sec" value="2.0" />
    <param name="child_wait_timeout" value="5.0" />
  </node>

  <test test-name="full_system_synthetic" pkg="mission_manager"
        type="test_full_system_synthetic_ros.py" time-limit="70.0" />
</launch>
