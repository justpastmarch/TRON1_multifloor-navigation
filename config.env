# TRON1 RViz navigation deployment values.
MINI_PC_HOST=192.168.1.56
MINI_PC_USER=m3localtron
MINI_PC_WORKSPACE=/home/m3localtron/catkin_ws
ROS_MASTER_PORT=11311
ROS_MASTER_HOST=192.168.1.26
MINI_PC_ROS_IP=192.168.1.56
D435F_SERIAL=244622071832

ROBOT_HOST=10.192.1.2
ROBOT_WS_PORT=5000
LOCAL_WS_PORT=5000
ACCID=WF_TRON1A_632
ROBOT_TYPE=WF_TRON1A

# Provision these topics from the approved sensor deployment.
POINTCLOUD_TOPIC=/livox/lidar
CAMERA_IMAGE_TOPIC="${CAMERA_IMAGE_TOPIC:-/camera1/color/image_raw}"
CAMERA_INFO_TOPIC="${CAMERA_INFO_TOPIC:-/camera1/color/camera_info}"
TAG_DETECTIONS_TOPIC=/tag_detections

# Manual 5F-rooftop capture topics. The camera uses image_transport JPEG;
# RAW_LIVOX_TOPIC must be the livox_ros_driver2/CustomMsg stream, not PointCloud2.
CAPTURE_CAMERA_TOPIC="${CAPTURE_CAMERA_TOPIC:-/camera1/color/image_raw/compressed}"
RAW_LIVOX_TOPIC="${RAW_LIVOX_TOPIC:-/livox/lidar}"
SCAN_TOPIC="${SCAN_TOPIC:-/scan}"
WHEEL_ODOM_TOPIC="${WHEEL_ODOM_TOPIC:-/tron/wheel_odom_raw}"
IMU_TOPIC="${IMU_TOPIC:-/livox/imu}"
SENSOR_JOY_TOPIC="${SENSOR_JOY_TOPIC:-/tron/sensor_joy}"
SENSOR_JOY_RECEIVER_AUTOSTART="${SENSOR_JOY_RECEIVER_AUTOSTART:-1}"
MANUAL_CAPTURE_OUTPUT_BASE="${MANUAL_CAPTURE_OUTPUT_BASE:-manual_captures}"

# These IDs must exist in the production site profile before startup is allowed.
INITIAL_FLOOR="${INITIAL_FLOOR:-5F}"
HOME_LOCATION_ID=home_3f
INITIAL_LOCATION_ID="${INITIAL_LOCATION_ID:-stair_5f_to_rf}"
INSPECT_PROFILE_ID=roof_scan_profile
SCAN_OUTPUT_BASE=/mnt/ethan/tron-bags/mission-artifacts

NAV_START_X=2.599130
NAV_START_Y=-1.983942
NAV_START_YAW=1.455898

# move_base speed and acceleration limits.
MAX_VEL_X=0.30
MAX_VEL_THETA=0.80
MIN_IN_PLACE_VEL_THETA=0.25
ACC_LIM_X=0.4
ACC_LIM_THETA=2.0

# auto: scan-map start search; manual: wait for 2D Pose Estimate; disabled: legacy seed
STARTUP_LOCALIZATION=auto

# This installation uses the existing LiDAR controller for stair driving.
# Environment overrides remain available for explicit offline observation.
TRON_DEPLOYMENT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STAIR_LIDAR_MODE="${STAIR_LIDAR_MODE:-control}"
STAIR_LIDAR_OBSERVE_ONLY="${STAIR_LIDAR_OBSERVE_ONLY:-false}"
STAIR_LIDAR_CONFIG="${STAIR_LIDAR_CONFIG:-${TRON_DEPLOYMENT_ROOT}/src/stair_supervisor/config/stair_lidar_3f_4f_test.yaml}"
STAIR_NUMERICAL_PYTHON="${STAIR_NUMERICAL_PYTHON:-${HOME}/.cache/uv/environments-v2/test-registration-core-26ae8f8cf1a8e532/bin/python}"
STAIR_SENSOR_PYTHONPATH="${STAIR_SENSOR_PYTHONPATH:-${HOME}/catkin_ws/devel/lib/python3/dist-packages}"
STAIR_PYTHON="${STAIR_PYTHON:-${TRON_DEPLOYMENT_ROOT}/src/stair_supervisor/scripts/stair_python.sh}"
if [[ "$STAIR_LIDAR_MODE" == "off" ]]; then
    STAIR_RECORD="${STAIR_RECORD:-0}"
else
    STAIR_RECORD="${STAIR_RECORD:-1}"
fi
export STAIR_LIDAR_MODE STAIR_LIDAR_OBSERVE_ONLY STAIR_LIDAR_CONFIG
export STAIR_NUMERICAL_PYTHON STAIR_SENSOR_PYTHONPATH STAIR_PYTHON STAIR_RECORD

# Restore the confirmed mission destination while idle using the existing NAV owner.
ARRIVAL_HOLD_SETTINGS="${ARRIVAL_HOLD_SETTINGS:-${TRON_DEPLOYMENT_ROOT}/src/mission_manager/config/arrival_hold.yaml}"
export ARRIVAL_HOLD_SETTINGS
