+def _load_imu(input_bag: rosbag.Bag, spec: ReplaySpec) -> tuple[ImuRotation, dict]:
+    content = spec.imu_calibration_path.expanduser().read_bytes()
+    calibration = yaml.safe_load(content)
+    rotation = np.asarray(
+        calibration["mapping"]["extrinsic_R"], dtype=np.float64
+    ).reshape(3, 3)
+    if (
+        not np.isfinite(rotation).all()
+        or not np.allclose(rotation.T @ rotation, np.eye(3), atol=1e-3)
+        or np.linalg.det(rotation) < 0.0
+    ):
+        raise ValueError("mapping/extrinsic_R is not a proper lidar-to-IMU rotation")
+    lidar_from_imu = Rotation.from_matrix(rotation).as_matrix().T
+    samples = []
+    for _, message, _ in input_bag.read_messages(topics=[spec.imu_topic]):
+        w, a = message.angular_velocity, message.linear_acceleration
+        samples.append([message.header.stamp.to_sec(), w.x, w.y, w.z, a.x, a.y, a.z])
+    trajectory = ImuRotation(
+        np.asarray(samples, dtype=np.float64), lidar_from_imu, spec.imu_max_gap_s
+    )
+    return trajectory, {
+        "calibration_path": str(spec.imu_calibration_path.expanduser()),
+        "calibration_sha256": hashlib.sha256(content).hexdigest(),
+        "lidar_to_imu_rotation": rotation.tolist(),
+        "imu_topic": spec.imu_topic,
+        "gravity_half_window_s": spec.gravity_half_window_s,
+        "imu_max_gap_s": spec.imu_max_gap_s,
+        "scope": "fixed rotation, gyro only; no acceleration integration, point deskew, bias estimation or sensor translation compensation",
+    }
 
 
