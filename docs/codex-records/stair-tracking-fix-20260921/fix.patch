+#!/usr/bin/env python3
+# /// script
+# requires-python = ">=3.8,<3.9"
+# dependencies = ["numpy==1.24.4", "open3d==0.18.0", "scipy==1.10.1",
+#   "pydantic==2.10.6", "PyYAML==6.0.3", "pycryptodomex==3.23.0",
+#   "python-gnupg==0.5.5", "rospkg==1.6.0", "typer==0.16.0"]
+# ///
+"""Synthetic bag regressions for observation validity, gravity, and recovery."""
+
+import csv
+import hashlib
+import json
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+import rosbag
+import rospy
+from livox_ros_driver2.msg import CustomMsg, CustomPoint
+from sensor_msgs.msg import Imu
+from tf.transformations import quaternion_matrix
+
+import process_bag as subject
+from registration_core import RegistrationResult, register_scan_to_map
+
+
+class BagOutputTests(unittest.TestCase):
+    def setUp(self):
+        self.temporary = tempfile.TemporaryDirectory(prefix="offline-lio-fix-test-")
+        self.addCleanup(self.temporary.cleanup)
+        self.root = Path(self.temporary.name)
+        calibration = self.root / "calibration.yaml"
+        calibration.write_text("mapping:\n  extrinsic_R: [1,0,0, 0,1,0, 0,0,1]\n")
+        self.spec = subject.ReplaySpec(
+            bag_path=self.root / "input.bag",
+            output_bag_path=self.root / "output.bag",
+            output_csv_path=self.root / "output.csv",
+            imu_calibration_path=calibration,
+            start_offset_s=0,
+            duration_s=5,
+            frame_step=1,
+            local_map_scans=3,
+            max_range_m=20,
+            registration=subject.RegistrationSettings(
+                voxel_size_m=0.2,
+                correspondence_distance_m=0.8,
+                max_iterations=30,
+                min_fitness=0.35,
+                max_translation_step_m=0.5,
+                max_rotation_step_rad=0.35,
+            ),
+        )
+        self.stamps = [rospy.Time(100, i * 200000000) for i in range(5)]
+
+    def make_bag(self, gap=False):
+        rng = np.random.default_rng(782)
+        # Large vertical wall; it must never become the world floor.
+        wall = np.column_stack(
+            (rng.uniform(-2, 2, 1200), np.full(1200, 1.5), rng.uniform(-0.5, 2, 1200))
+        )
+        floor = np.column_stack(
+            (rng.uniform(-2, 2, 300), rng.uniform(-2, 2, 300), np.full(300, -0.7))
+        )
+        with rosbag.Bag(str(self.spec.bag_path), "w") as bag:
+            for tick in range(400):
+                ns = 99400000000 + tick * 5000000
+                if gap and 100300000000 <= ns < 100450000000:
+                    continue
+                msg = Imu()
+                msg.header.stamp = rospy.Time(ns // 1000000000, ns % 1000000000)
+                msg.linear_acceleration.z = 1.0
+                bag.write("/livox/imu", msg, msg.header.stamp + rospy.Duration(0.3))
+            for stamp in self.stamps:
+                msg = CustomMsg()
+                msg.header.stamp = stamp
+                msg.header.frame_id = "mid360_link"
+                msg.points = [
+                    CustomPoint(x=float(x), y=float(y), z=float(z))
+                    for x, y, z in np.vstack((wall, floor))
+                ]
+                msg.point_num = len(msg.points)
+                bag.write("/livox/lidar", msg, stamp + rospy.Duration(0.3))
+
+    def test_rejected_pose_never_gets_fresh_odometry_and_recovery_is_segmented(self):
+        self.make_bag()
+        original_hash = hashlib.sha256(self.spec.bag_path.read_bytes()).hexdigest()
+        calls = 0
+
+        def inject_fault(source, target, prediction, config):
+            nonlocal calls
+            calls += 1
+            if calls in (2, 4):
+                return RegistrationResult(prediction.copy(), 1.0, 0.1, 1.0, 0.0, False)
+            return register_scan_to_map(source, target, prediction, config)
+
+        with patch.object(subject, "register_scan_to_map", side_effect=inject_fault):
+            result = subject.process(self.spec)
+        self.assertEqual(result["rejected_frames"], 2)
+        with rosbag.Bag(str(self.spec.output_bag_path), "r") as bag:
+            messages = list(bag.read_messages())
+        odometry = [m for t, m, _ in messages if t.endswith("/odom")]
+        self.assertEqual(
+            [m.header.stamp for m in odometry], [self.stamps[i] for i in (0, 1, 3)]
+        )
+        initial = odometry[0].pose.pose.orientation
+        np.testing.assert_allclose(
+            quaternion_matrix([initial.x, initial.y, initial.z, initial.w]),
+            np.eye(4),
+            atol=1e-9,
+        )
+        statuses = [json.loads(m.data) for t, m, _ in messages if t.endswith("/status")]
+        self.assertEqual(len(statuses), 5)
+        self.assertFalse(statuses[0]["geometry_valid"])
+        self.assertTrue(statuses[1]["geometry_valid"])
+        self.assertFalse(statuses[2]["measurement_valid"])
+        self.assertEqual(statuses[4]["last_valid_stamp_ns"], self.stamps[3].to_nsec())
+        self.assertIn("translation innovation", statuses[2]["reason"])
+        paths = [m for t, m, _ in messages if t.endswith("/path")]
+        self.assertEqual([len(m.poses) for m in paths], [1, 2, 0, 1, 0])
+        clouds = [m for t, m, _ in messages if t.endswith("/cloud")]
+        self.assertEqual([clouds[i].width for i in (2, 4)], [0, 0])
+        global_map = [m for t, m, _ in messages if t.endswith("/global_map")][0]
+        self.assertEqual(global_map.header.stamp, self.stamps[3])
+        with self.spec.output_csv_path.open() as stream:
+            rows = list(csv.DictReader(stream))
+        self.assertTrue(
+            all(
+                np.isnan(float(rows[i][k]))
+                for i in (2, 4)
+                for k in ("x_m", "y_m", "z_m", "qx", "qy", "qz", "qw")
+            )
+        )
+        self.assertEqual(
+            hashlib.sha256(self.spec.bag_path.read_bytes()).hexdigest(), original_hash
+        )
+
+    def test_imu_gap_can_recover_geometrically_without_loosening_limits(self):
+        self.make_bag(gap=True)
+        result = subject.process(self.spec)
+        self.assertEqual(result["rejected_frames"], 0)
+        with rosbag.Bag(str(self.spec.output_bag_path), "r") as bag:
+            statuses = [
+                json.loads(m.data)
+                for _, m, _ in bag.read_messages(topics=["/lidar_registration/status"])
+            ]
+        self.assertEqual(statuses[2]["prediction_source"], "last_observation")
+        self.assertIn("without IMU", statuses[2]["reason"])
+        self.assertEqual(statuses[-1]["prediction_source"], "gyro")
+        self.assertTrue(statuses[-1]["measurement_valid"])
+
+    def test_input_bag_cannot_be_selected_as_output(self):
+        self.make_bag()
+        with self.assertRaisesRegex(ValueError, "distinct"):
+            subject.process(
+                self.spec.model_copy(update={"output_bag_path": self.spec.bag_path})
+            )
+
+    def test_empty_window_fails_before_replacing_existing_outputs(self):
+        self.make_bag()
+        self.spec.output_bag_path.write_bytes(b"previous output")
+        self.spec.output_csv_path.write_text("previous CSV")
+        with self.assertRaisesRegex(ValueError, "no LiDAR messages"):
+            subject.process(self.spec.model_copy(update={"start_offset_s": 50}))
+        self.assertEqual(self.spec.output_bag_path.read_bytes(), b"previous output")
+        self.assertEqual(self.spec.output_csv_path.read_text(), "previous CSV")
+
+    def test_short_empty_scan_is_predicted_but_has_no_measurement(self):
+        self.make_bag()
+        actual = subject.voxel_downsample_points
+        calls = 0
+
+        def drop_one_scan(points, voxel):
+            nonlocal calls
+            calls += 1
+            return np.empty((0, 3)) if calls == 2 else actual(points, voxel)
+
+        with patch.object(
+            subject, "voxel_downsample_points", side_effect=drop_one_scan
+        ):
+            subject.process(self.spec)
+        with rosbag.Bag(str(self.spec.output_bag_path), "r") as bag:
+            states = [
+                json.loads(m.data)
+                for _, m, _ in bag.read_messages(topics=["/lidar_registration/status"])
+            ]
+        self.assertEqual(states[1]["state"], "PREDICTED")
+        self.assertFalse(states[1]["measurement_valid"])
+        self.assertFalse(states[1]["geometry_valid"])
+        self.assertEqual(states[2]["state"], "TRACKED")
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
