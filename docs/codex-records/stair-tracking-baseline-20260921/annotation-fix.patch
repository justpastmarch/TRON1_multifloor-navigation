--- a/test_comparison_markers.py
+++ b/test_comparison_markers.py
@@ -0,0 +1,44 @@
+"""Regression: video annotations must not imply arrival before their timestamp."""
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+import numpy as np
+import rospy
+from sensor_msgs.msg import Image
+
+from build_comparison_bag import _associate_events
+from comparison_markers import ComparisonEvidence, TraversalEventEvidence, event_marker_array
+from comparison_trajectory import StampedTransform
+from event_camera import StampedImage
+from traversal_events import TraversalEventSet
+
+
+class AnnotationTests(unittest.TestCase):
+    def setUp(self):
+        self.events = tuple(TraversalEventEvidence(name, np.array([i, 0., 0.]), 0.01, stamp)
+                            for i, (name, stamp) in enumerate([
+                                ('STAIR_ENTRY', 100.), ('INTERMEDIATE_LANDING', 110.), ('FINAL_ARRIVAL', 120.)]))
+        self.evidence = ComparisonEvidence(self.events, np.zeros(3), None, 0, 0)
+
+    def test_markers_appear_at_camera_time_and_keep_stable_ids(self):
+        for stamp, expected_ids in [(99., []), (100., [0, 1]), (115., [0, 1, 2, 3]),
+                                    (119.999, [0, 1, 2, 3]), (120., [0, 1, 2, 3, 4, 5])]:
+            markers = event_marker_array(self.evidence, rospy.Time.from_sec(stamp)).markers
+            self.assertEqual([m.id for m in markers if m.id < 6], expected_ids)
+        markers = event_marker_array(self.evidence, rospy.Time.from_sec(120.)).markers
+        self.assertIn('video annotation', next(m.text for m in markers if m.id == 5))
+
+    def test_camera_annotation_outside_observed_poses_cannot_clamp_to_endpoint(self):
+        specs = TraversalEventSet.model_validate([
+            {'name': e.name, 'camera_header_stamp_s': e.camera_header_stamp_s} for e in self.events])
+        poses = [StampedTransform(rospy.Time.from_sec(t), np.eye(4)) for t in [99., 115.]]
+        def image_at(_path, stamp):
+            return StampedImage(rospy.Time.from_sec(stamp), Image())
+        with patch('build_comparison_bag.read_event_image', side_effect=image_at):
+            with self.assertRaisesRegex(ValueError, 'FINAL_ARRIVAL.*outside'):
+                _associate_events(specs, Path('unused-input.bag'), poses)
+
+
+if __name__ == '__main__':
+    unittest.main()
